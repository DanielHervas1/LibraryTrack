# Copia este archivo como .env.local y rellena los valores.
# .env.local nunca se sube al repo (.gitignore ya lo excluye).

# TMDB — Read Access Token (v4). Obtenerlo en:
# https://www.themoviedb.org/settings/api → "API Read Access Token"
TMDB_READ_ACCESS_TOKEN=

# Google Books — opcional. Sin key se usa Open Library para los libros (la cuota
# anónima de Google Books está agotada). Con key (gratis): https://console.cloud.google.com/
GOOGLE_BOOKS_API_KEY=

# Supabase — el project URL y la anon key son públicas por diseño (protegidas con RLS).
# Las encuentras en: Settings → API dentro de tu proyecto de Supabase.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Supabase service-role key — SECRETO, solo servidor, nunca exponer al cliente.
SUPABASE_SERVICE_ROLE_KEY=

# Tu email; limita el acceso al login solo a esta cuenta.
ALLOWED_EMAIL=
